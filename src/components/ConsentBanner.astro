---
// Cookie banner: one line of text, equal "Akkoord" and "Weigeren" buttons, per-purpose settings.
// Any element with [data-consent-open] (the footer link) reopens it.
import { url } from '../lib/url';

const buttonBase = 'label-caps min-w-0 flex-1 cursor-pointer border px-2 py-3 text-center md:flex-none md:px-5';
const buttonSolid = 'border-black bg-black text-cream hover:bg-transparent hover:text-black';
---

<section
  id="consent-banner"
  aria-label="Cookietoestemming"
  hidden
  class="fixed inset-x-0 bottom-0 z-50 border-t border-black/20 bg-cream text-black shadow-[0_-8px_24px_rgba(0,0,0,0.12)]"
>
  <div class="container-site flex flex-col gap-3 py-4 md:flex-row md:flex-wrap md:items-center md:gap-x-8">
    <p class="text-[15px] leading-[22px] md:min-w-0 md:flex-1">
      We gebruiken cookies voor statistiek en voor Instagram en Facebook, alleen met je akkoord.{' '}
      <a href={url('/cookies/')} class="underline">Meer info</a>{' '}
      <span aria-hidden="true">·</span>{' '}
      <button type="button" data-consent="settings" aria-controls="consent-settings" aria-expanded="false" class="cursor-pointer underline">
        Instellingen
      </button>
    </p>

    <div class="flex gap-3">
      <button type="button" data-consent="reject" class:list={[buttonBase, buttonSolid]}>Weigeren</button>
      <button type="button" data-consent="accept" class:list={[buttonBase, buttonSolid]}>Akkoord</button>
      <button type="button" data-consent="save" hidden class:list={[buttonBase, 'border-black hover:bg-black hover:text-cream']}>Opslaan</button>
    </div>

    <form id="consent-settings" hidden class="flex flex-col gap-2 text-[15px] leading-[22px] md:basis-full md:flex-row md:gap-8">
      <label class="flex items-center gap-2">
        <input type="checkbox" checked disabled class="size-4 accent-black" />
        Noodzakelijk
      </label>
      <label class="flex items-center gap-2">
        <input type="checkbox" name="analytics" class="size-4 accent-black" />
        Statistiek (Google Analytics)
      </label>
      <label class="flex items-center gap-2">
        <input type="checkbox" name="marketing" class="size-4 accent-black" />
        Marketing (Meta-pixel)
      </label>
    </form>
  </div>
</section>

<script is:inline>
  (function () {
    var banner = document.getElementById('consent-banner');
    var settings = document.getElementById('consent-settings');
    var toggle = banner.querySelector('[data-consent="settings"]');
    var save = banner.querySelector('[data-consent="save"]');
    var consent = window.arhConsent;

    function showSettings(show) {
      settings.hidden = !show;
      save.hidden = !show;
      toggle.setAttribute('aria-expanded', String(show));
    }

    function open(withSettings) {
      var current = consent.get();
      settings.elements.analytics.checked = !!(current && current.analytics);
      settings.elements.marketing.checked = !!(current && current.marketing);
      showSettings(withSettings);
      banner.hidden = false;
    }

    function choose(analytics, marketing) {
      banner.hidden = true;
      consent.set({ analytics: analytics, marketing: marketing });
    }

    banner.addEventListener('click', function (event) {
      var button = event.target.closest('[data-consent]');
      if (!button) return;
      var action = button.getAttribute('data-consent');
      if (action === 'accept') choose(true, true);
      if (action === 'reject') choose(false, false);
      if (action === 'settings') showSettings(true);
      if (action === 'save') choose(settings.elements.analytics.checked, settings.elements.marketing.checked);
    });

    document.addEventListener('click', function (event) {
      if (!event.target.closest('[data-consent-open]')) return;
      event.preventDefault();
      open(true);
    });

    if (!consent.get()) open(false);
  })();
</script>
