---
import CoffeeIcon from './CoffeeIcon.astro';
import Button from './Button.astro';
import { site } from '../data/site';

interface Props {
  text: string;
  layout?: 'stacked' | 'row';
  headingLevel?: 'h2' | 'h3';
}
const { text, layout = 'stacked', headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
---

<aside
  class:list={[
    'flex gap-6 bg-saddle px-5 py-7 text-milk md:p-8',
    layout === 'stacked' ? 'min-h-80 flex-col justify-between md:gap-8' : 'min-w-0 flex-[1_1_460px] flex-wrap items-center md:gap-7 md:p-10',
  ]}
>
  <span class="flex-none"><CoffeeIcon size={layout === 'row' ? 64 : 48} /></span>
  <div class:list={['flex flex-col gap-2.5 md:gap-3', layout === 'row' && 'flex-[1_1_220px]']}>
    <Heading class="font-display text-[28px] leading-8 font-semibold tracking-[-0.02em] md:text-[32px] md:leading-9">Meer weten?</Heading>
    <p class="text-base leading-6 text-oat">{text}</p>
  </div>
  <Button href={`mailto:${site.email}`} variant="light" class="sm:self-start">Maak een afspraak</Button>
</aside>
