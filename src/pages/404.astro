---
import { url } from '../lib/url';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
---

<BaseLayout title="Pagina niet gevonden – AR Horses" description="Deze pagina bestaat niet.">
  <section class="container-site flex flex-col items-start gap-6 py-24">
    <h1 class="font-display text-6xl font-bold tracking-[-0.03em] text-ink">Niet gevonden.</h1>
    <p class="text-lg">Deze pagina bestaat niet (meer).</p>
    <Button href={url('/')}>Naar de homepage</Button>
  </section>
</BaseLayout>
